# Required for the database-backed app
DATABASE_URL=

# Local app URL (needed for absolute links in emails)
BETTER_AUTH_URL=http://localhost:3000

# Optional, only used when the Resend email helper is wired up
RESEND_API_KEY=
EMAIL_FROM=

# Required only when running npm run db:seed to create throwaway demo accounts
SEED_ADMIN_PASSWORD=
SEED_BUYER_PASSWORD=
SEED_VENDOR_PASSWORD=
SEED_RIDER_PASSWORD=
