# Required for the database-backed app
DATABASE_URL=

# Local app URL (needed for absolute links and by Better Auth as its base URL)
BETTER_AUTH_URL=

# Required by Better Auth (read by the library itself, never by our code).
# Generate one locally, for example:  openssl rand -base64 32
# Use a DIFFERENT secret on Vercel (each environment must have its own secret).
BETTER_AUTH_SECRET=

# Optional, only used when the Resend email helper is wired up
RESEND_API_KEY=
EMAIL_FROM=

# Required only when running npm run db:seed to create throwaway demo accounts
SEED_ADMIN_PASSWORD=
SEED_BUYER_PASSWORD=
SEED_VENDOR_PASSWORD=
SEED_RIDER_PASSWORD=
